{
    "elements": [
        {
            "type": "Label",
            "caption": "Configure the Symcon variables that can act as alarm sensors or triggers."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Delays",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ExitDelaySeconds",
                            "caption": "Exit delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "EntryDelaySeconds",
                            "caption": "Entry delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 disables the corresponding delay."
                }
            ]
        },
        {
            "type": "List",
            "name": "Sensors",
            "caption": "Sensors and triggers",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Enabled",
                    "name": "Enabled",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Sensor type",
                    "name": "SensorType",
                    "width": "170px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Opening contact",
                                "value": 0
                            },
                            {
                                "caption": "Motion detector",
                                "value": 1
                            },
                            {
                                "caption": "Glass break detector",
                                "value": 2
                            },
                            {
                                "caption": "Smoke detector",
                                "value": 3
                            },
                            {
                                "caption": "Water detector",
                                "value": 4
                            },
                            {
                                "caption": "Panic trigger",
                                "value": 5
                            },
                            {
                                "caption": "Other trigger",
                                "value": 6
                            }
                        ]
                    }
                },
                {
                    "caption": "Trigger value",
                    "name": "TriggerValue",
                    "width": "125px",
                    "add": "1",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "",
                    "name": "TriggerValueSelection",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "",
                    "name": "TriggerValueManual",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "Home",
                    "name": "ArmHome",
                    "width": "90px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Away",
                    "name": "ArmAway",
                    "width": "95px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Night",
                    "name": "ArmNight",
                    "width": "75px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Entry delay",
                    "name": "EntryDelay",
                    "width": "130px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ],
            "form": [
                "return OHA_GetSensorEditForm($id, $Sensors);"
            ]
        },
        {
            "type": "Label",
            "caption": "Selectable variable states are shown as a consistent list; variables without discrete states keep a raw-value input."
        }
    ],
    "actions": [],
    "status": []
}
