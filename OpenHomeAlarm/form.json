{
    "elements": [
        {
            "type": "Label",
            "caption": "Configure the Symcon variables that can act as alarm sensors or triggers."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Alarm partitions",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure independently addressable alarm areas. Exactly one enabled partition must be the default."
                },
                {
                    "type": "List",
                    "name": "Partitions",
                    "caption": "Partitions",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Enabled",
                            "name": "Enabled",
                            "width": "80px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Partition ID",
                            "name": "ID",
                            "width": "180px",
                            "add": "area",
                            "edit": {
                                "type": "ValidationTextBox",
                                "validate": "^[a-z][a-z0-9_-]{0,31}$"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Default partition",
                            "name": "Default",
                            "width": "130px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Partition IDs are stable technical identifiers and cannot contain spaces."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "IPSView",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional IPSView HTML output."
                },
                {
                    "type": "Label",
                    "caption": "Configure the shared IPSView style used by the standalone HTML page."
                },
                {
                    "type": "Label",
                    "caption": "In IPSView, use an HTML-Box with the client browser renderer so JavaScript and the controls are available."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Delays",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ExitDelaySeconds",
                            "caption": "Exit delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "EntryDelaySeconds",
                            "caption": "Entry delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 disables the corresponding delay."
                },
                {
                    "type": "Select",
                    "name": "CountdownActionEnabled",
                    "caption": "Countdown output",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "The optional action runs once for every positive countdown value. Its target can read DelayRemaining, DelaySource, Mode and State from this instance."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Code protection",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure an optional numeric code for disarming from user-facing controls."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "DisarmCode",
                    "caption": "Disarm code (4-8 digits)",
                    "validate": "^(?:[0-9]{4,8})?$",
                    "width": "250px"
                },
                {
                    "type": "List",
                    "name": "DisarmUsers",
                    "caption": "Disarm users",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Enabled",
                            "name": "Enabled",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "User name",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Code (4-8 digits)",
                            "name": "Code",
                            "width": "180px",
                            "add": "",
                            "edit": {
                                "type": "PasswordTextBox",
                                "validate": "^(?:[0-9]{4,8})?$"
                            }
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "DisarmMaxAttempts",
                            "caption": "Maximum failed attempts",
                            "minimum": 1,
                            "maximum": 20,
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "DisarmLockoutSeconds",
                            "caption": "Temporary lockout (seconds)",
                            "minimum": 1,
                            "maximum": 3600,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Leave empty to allow disarming without a code."
                },
                {
                    "type": "Label",
                    "caption": "After too many failed attempts, code entry is blocked temporarily. Trusted automations can still use Disarm()."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Automatic arming",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure weekly schedules that arm the system through the normal readiness checks."
                },
                {
                    "type": "List",
                    "name": "AutomaticArmingSchedules",
                    "caption": "Arming schedules",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Enabled",
                            "name": "Enabled",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Mon",
                            "name": "Monday",
                            "width": "55px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Tue",
                            "name": "Tuesday",
                            "width": "55px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Wed",
                            "name": "Wednesday",
                            "width": "55px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Thu",
                            "name": "Thursday",
                            "width": "55px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Fri",
                            "name": "Friday",
                            "width": "55px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Sat",
                            "name": "Saturday",
                            "width": "55px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Sun",
                            "name": "Sunday",
                            "width": "55px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Time",
                            "name": "Time",
                            "width": "90px",
                            "add": "08:00",
                            "edit": {
                                "type": "ValidationTextBox",
                                "validate": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                            }
                        },
                        {
                            "caption": "Arming mode",
                            "name": "Mode",
                            "width": "140px",
                            "add": "away",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Home",
                                        "value": "home"
                                    },
                                    {
                                        "caption": "Away",
                                        "value": "away"
                                    },
                                    {
                                        "caption": "Night",
                                        "value": "night"
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Automatic arming never bypasses sensors or blocking faults and never disarms or changes an already active mode."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Alarm actions",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional Symcon actions for alarm start, automatic alarm-output reset and disarming after an alarm."
                },
                {
                    "type": "Label",
                    "caption": "Optional actions are disabled by default. Select Configure action and apply once; the native Symcon action selector will then appear."
                },
                {
                    "type": "NumberSpinner",
                    "name": "AlarmDurationSeconds",
                    "caption": "Alarm duration (seconds)",
                    "minimum": 0,
                    "width": "250px"
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 keeps the alarm output active until it is reset manually or the system is disarmed."
                },
                {
                    "type": "Select",
                    "name": "AlarmActionEnabled",
                    "caption": "Alarm start",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "Select",
                    "name": "AlarmResetActionEnabled",
                    "caption": "Reset alarm output",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "Select",
                    "name": "DisarmAfterAlarmActionEnabled",
                    "caption": "Disarm after alarm",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "System monitoring",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional 24/7 inputs for tamper, battery/power, communication or device faults."
                },
                {
                    "type": "NumberSpinner",
                    "name": "SensorIntegrityIntervalSeconds",
                    "caption": "Sensor integrity check (seconds)",
                    "minimum": 10,
                    "maximum": 3600,
                    "width": "300px"
                },
                {
                    "type": "Label",
                    "caption": "Configured sensor variables are checked periodically and immediately when Symcon reports their removal."
                },
                {
                    "type": "Label",
                    "caption": "Optional fault actions are disabled by default. Enable one and apply once before selecting the Symcon action."
                },
                {
                    "type": "Select",
                    "name": "FaultActionEnabled",
                    "caption": "New fault",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "Select",
                    "name": "FaultClearedActionEnabled",
                    "caption": "Fault cleared",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "List",
                    "name": "FaultInputs",
                    "caption": "Tamper and fault inputs",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Enabled",
                            "name": "Enabled",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Alarm partition",
                            "name": "PartitionID",
                            "width": "150px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable"
                            }
                        },
                        {
                            "caption": "Fault type",
                            "name": "FaultType",
                            "width": "180px",
                            "add": 0,
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Tamper",
                                        "value": 0
                                    },
                                    {
                                        "caption": "Battery / power",
                                        "value": 1
                                    },
                                    {
                                        "caption": "Communication",
                                        "value": 2
                                    },
                                    {
                                        "caption": "Device fault",
                                        "value": 3
                                    },
                                    {
                                        "caption": "Other fault",
                                        "value": 4
                                    }
                                ]
                            }
                        },
                        {
                            "caption": "Fault value",
                            "name": "TriggerValue",
                            "width": "125px",
                            "add": "1",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "",
                            "name": "TriggerValueSelection",
                            "width": "1px",
                            "visible": false,
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "",
                            "name": "TriggerValueManual",
                            "width": "1px",
                            "visible": false,
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "Block arming",
                            "name": "BlockArming",
                            "width": "120px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Alarm",
                            "name": "TriggerAlarm",
                            "width": "80px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        }
                    ],
                    "form": [
                        "return OHA_GetFaultInputEditForm($id, $FaultInputs);"
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Missing or unreadable configured fault variables are reported as a system fault and can block arming, but do not trigger the main alarm unless the configured fault value is positively detected."
                }
            ]
        },
        {
            "type": "List",
            "name": "Sensors",
            "caption": "Sensors and triggers",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Enabled",
                    "name": "Enabled",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Alarm partition",
                    "name": "PartitionID",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Sensor type",
                    "name": "SensorType",
                    "width": "170px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Opening contact",
                                "value": 0
                            },
                            {
                                "caption": "Motion detector",
                                "value": 1
                            },
                            {
                                "caption": "Glass break detector",
                                "value": 2
                            },
                            {
                                "caption": "Smoke detector",
                                "value": 3
                            },
                            {
                                "caption": "Water detector",
                                "value": 4
                            },
                            {
                                "caption": "Panic trigger",
                                "value": 5
                            },
                            {
                                "caption": "Other trigger",
                                "value": 6
                            }
                        ]
                    }
                },
                {
                    "caption": "Trigger value",
                    "name": "TriggerValue",
                    "width": "125px",
                    "add": "1",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "",
                    "name": "TriggerValueSelection",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "",
                    "name": "TriggerValueManual",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "Home",
                    "name": "ArmHome",
                    "width": "90px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Away",
                    "name": "ArmAway",
                    "width": "95px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Night",
                    "name": "ArmNight",
                    "width": "75px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "24/7",
                    "name": "AlwaysActive",
                    "width": "70px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Exit route",
                    "name": "ExitDelay",
                    "width": "115px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Entry delay",
                    "name": "EntryDelay",
                    "width": "130px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ],
            "form": [
                "return OHA_GetSensorEditForm($id, $Sensors);"
            ]
        },
        {
            "type": "Label",
            "caption": "Selectable variable states are shown as a consistent list; variables without discrete states keep a raw-value input."
        },
        {
            "type": "Label",
            "caption": "24/7 sensors trigger immediately regardless of the current arming mode; mode assignments and entry/exit delay are ignored."
        }
    ],
    "actions": [],
    "status": []
}
