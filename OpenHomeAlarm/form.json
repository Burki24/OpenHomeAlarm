{
    "elements": [
        {
            "type": "Label",
            "caption": "Configure the Symcon variables that can act as alarm sensors or triggers."
        },
        {
            "type": "ExpansionPanel",
            "caption": "IPSView",
            "expanded": false,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnableIPSView",
                    "caption": "Provide IPSView HTML page"
                },
                {
                    "type": "Label",
                    "caption": "Creates a WebContent variable with a fully operable alarm dashboard for an IPSView HTML-Box."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "IPSViewTransparent",
                            "caption": "Transparent background",
                            "width": "250px"
                        },
                        {
                            "type": "Select",
                            "name": "IPSViewTheme",
                            "caption": "Color scheme",
                            "options": [
                                {
                                    "caption": "Custom colors",
                                    "value": 0
                                },
                                {
                                    "caption": "Light",
                                    "value": 1
                                },
                                {
                                    "caption": "Dark",
                                    "value": 2
                                }
                            ],
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "IPSViewFontScale",
                            "caption": "Font size (%)",
                            "minimum": 80,
                            "maximum": 200,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "For Custom colors, choose the dashboard palette directly. These colors are stored in the module configuration and do not require IPSView color variables."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "IPSViewPageColorValue",
                            "caption": "Page/background color",
                            "allowTransparent": false,
                            "width": "250px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "IPSViewSurfaceColorValue",
                            "caption": "Cards and controls",
                            "allowTransparent": false,
                            "width": "250px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "IPSViewSurfaceStrongColorValue",
                            "caption": "Highlighted surface",
                            "allowTransparent": false,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "IPSViewTextColorValue",
                            "caption": "Primary text color",
                            "allowTransparent": false,
                            "width": "250px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "IPSViewMutedTextColorValue",
                            "caption": "Secondary text color",
                            "allowTransparent": false,
                            "width": "250px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "IPSViewAccentColorValue",
                            "caption": "Accent/active color",
                            "allowTransparent": false,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "IPSViewSuccessColorValue",
                            "caption": "Ready/active color",
                            "allowTransparent": false,
                            "width": "250px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "IPSViewWarningColorValue",
                            "caption": "Warning/delay color",
                            "allowTransparent": false,
                            "width": "250px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "IPSViewDangerColorValue",
                            "caption": "Alarm/error color",
                            "allowTransparent": false,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "The selected colors define the IPSView palette. Card surfaces and text colors are corrected only when needed for readable contrast. Opacity for unavailable controls and the existing status gradients are preserved. Transparent background is controlled separately above."
                },
                {
                    "type": "Label",
                    "caption": "In IPSView, use an HTML-Box with the client browser renderer so JavaScript and the controls are available."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Delays",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ExitDelaySeconds",
                            "caption": "Exit delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "EntryDelaySeconds",
                            "caption": "Entry delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 disables the corresponding delay."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Code protection",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure an optional numeric code for disarming from user-facing controls."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "DisarmCode",
                    "caption": "Disarm code (4-8 digits)",
                    "validate": "^(?:[0-9]{4,8})?$",
                    "width": "250px"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "DisarmMaxAttempts",
                            "caption": "Maximum failed attempts",
                            "minimum": 1,
                            "maximum": 20,
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "DisarmLockoutSeconds",
                            "caption": "Temporary lockout (seconds)",
                            "minimum": 1,
                            "maximum": 3600,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Leave empty to allow disarming without a code."
                },
                {
                    "type": "Label",
                    "caption": "After too many failed attempts, code entry is blocked temporarily. Trusted automations can still use Disarm()."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Alarm actions",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional Symcon actions for alarm start, automatic alarm-output reset and disarming after an alarm."
                },
                {
                    "type": "Label",
                    "caption": "Optional actions are disabled by default. Select Configure action and apply once; the native Symcon action selector will then appear."
                },
                {
                    "type": "NumberSpinner",
                    "name": "AlarmDurationSeconds",
                    "caption": "Alarm duration (seconds)",
                    "minimum": 0,
                    "width": "250px"
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 keeps the alarm output active until it is reset manually or the system is disarmed."
                },
                {
                    "type": "Select",
                    "name": "AlarmActionEnabled",
                    "caption": "Alarm start",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "Select",
                    "name": "AlarmResetActionEnabled",
                    "caption": "Reset alarm output",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "Select",
                    "name": "DisarmAfterAlarmActionEnabled",
                    "caption": "Disarm after alarm",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "System monitoring",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional 24/7 inputs for tamper, battery/power, communication or device faults."
                },
                {
                    "type": "NumberSpinner",
                    "name": "SensorIntegrityIntervalSeconds",
                    "caption": "Sensor integrity check (seconds)",
                    "minimum": 10,
                    "maximum": 3600,
                    "width": "300px"
                },
                {
                    "type": "Label",
                    "caption": "Configured sensor variables are checked periodically and immediately when Symcon reports their removal."
                },
                {
                    "type": "Label",
                    "caption": "Optional fault actions are disabled by default. Enable one and apply once before selecting the Symcon action."
                },
                {
                    "type": "Select",
                    "name": "FaultActionEnabled",
                    "caption": "New fault",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "Select",
                    "name": "FaultClearedActionEnabled",
                    "caption": "Fault cleared",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Configure action",
                            "value": 1
                        }
                    ],
                    "width": "300px"
                },
                {
                    "type": "List",
                    "name": "FaultInputs",
                    "caption": "Tamper and fault inputs",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Enabled",
                            "name": "Enabled",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable"
                            }
                        },
                        {
                            "caption": "Fault type",
                            "name": "FaultType",
                            "width": "180px",
                            "add": 0,
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Tamper",
                                        "value": 0
                                    },
                                    {
                                        "caption": "Battery / power",
                                        "value": 1
                                    },
                                    {
                                        "caption": "Communication",
                                        "value": 2
                                    },
                                    {
                                        "caption": "Device fault",
                                        "value": 3
                                    },
                                    {
                                        "caption": "Other fault",
                                        "value": 4
                                    }
                                ]
                            }
                        },
                        {
                            "caption": "Fault value",
                            "name": "TriggerValue",
                            "width": "125px",
                            "add": "1",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "",
                            "name": "TriggerValueSelection",
                            "width": "1px",
                            "visible": false,
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "",
                            "name": "TriggerValueManual",
                            "width": "1px",
                            "visible": false,
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "Block arming",
                            "name": "BlockArming",
                            "width": "120px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Alarm",
                            "name": "TriggerAlarm",
                            "width": "80px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        }
                    ],
                    "form": [
                        "return OHA_GetFaultInputEditForm($id, $FaultInputs);"
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Missing or unreadable configured fault variables are reported as a system fault and can block arming, but do not trigger the main alarm unless the configured fault value is positively detected."
                }
            ]
        },
        {
            "type": "List",
            "name": "Sensors",
            "caption": "Sensors and triggers",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Enabled",
                    "name": "Enabled",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Sensor type",
                    "name": "SensorType",
                    "width": "170px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Opening contact",
                                "value": 0
                            },
                            {
                                "caption": "Motion detector",
                                "value": 1
                            },
                            {
                                "caption": "Glass break detector",
                                "value": 2
                            },
                            {
                                "caption": "Smoke detector",
                                "value": 3
                            },
                            {
                                "caption": "Water detector",
                                "value": 4
                            },
                            {
                                "caption": "Panic trigger",
                                "value": 5
                            },
                            {
                                "caption": "Other trigger",
                                "value": 6
                            }
                        ]
                    }
                },
                {
                    "caption": "Trigger value",
                    "name": "TriggerValue",
                    "width": "125px",
                    "add": "1",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "",
                    "name": "TriggerValueSelection",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "",
                    "name": "TriggerValueManual",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "Home",
                    "name": "ArmHome",
                    "width": "90px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Away",
                    "name": "ArmAway",
                    "width": "95px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Night",
                    "name": "ArmNight",
                    "width": "75px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "24/7",
                    "name": "AlwaysActive",
                    "width": "70px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Exit route",
                    "name": "ExitDelay",
                    "width": "115px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Entry delay",
                    "name": "EntryDelay",
                    "width": "130px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ],
            "form": [
                "return OHA_GetSensorEditForm($id, $Sensors);"
            ]
        },
        {
            "type": "Label",
            "caption": "Selectable variable states are shown as a consistent list; variables without discrete states keep a raw-value input."
        },
        {
            "type": "Label",
            "caption": "24/7 sensors trigger immediately regardless of the current arming mode; mode assignments and entry/exit delay are ignored."
        }
    ],
    "actions": [],
    "status": []
}
