{
    "elements": [
        {
            "type": "Label",
            "caption": "Configure the Symcon variables that can act as alarm sensors or triggers."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Delays",
            "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ExitDelaySeconds",
                            "caption": "Exit delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "EntryDelaySeconds",
                            "caption": "Entry delay (seconds)",
                            "minimum": 0,
                            "width": "250px"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 disables the corresponding delay."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Code protection",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure an optional numeric code for disarming from user-facing controls."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "DisarmCode",
                    "caption": "Disarm code (4-8 digits)",
                    "validate": "^(?:[0-9]{4,8})?$",
                    "width": "250px"
                },
                {
                    "type": "Label",
                    "caption": "Leave empty to allow disarming without a code."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Alarm actions",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional Symcon actions for alarm start, automatic alarm-output reset and disarming after an alarm."
                },
                {
                    "type": "NumberSpinner",
                    "name": "AlarmDurationSeconds",
                    "caption": "Alarm duration (seconds)",
                    "minimum": 0,
                    "width": "250px"
                },
                {
                    "type": "Label",
                    "caption": "A value of 0 keeps the alarm output active until it is reset manually or the system is disarmed."
                },
                {
                    "type": "Select",
                    "name": "AlarmActionEnabled",
                    "caption": "Alarm start action",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Use action",
                            "value": 1
                        }
                    ],
                    "onChange": "OHA_SetOptionalActionFieldEnabled($id, 'AlarmAction', $AlarmActionEnabled === 1);",
                    "width": "250px"
                },
                {
                    "type": "SelectAction",
                    "name": "AlarmAction",
                    "caption": "On alarm",
                    "targetID": -2,
                    "width": "100%",
                    "enabled": false,
                    "visible": false
                },
                {
                    "type": "Select",
                    "name": "AlarmResetActionEnabled",
                    "caption": "Alarm output reset action",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Use action",
                            "value": 1
                        }
                    ],
                    "onChange": "OHA_SetOptionalActionFieldEnabled($id, 'AlarmResetAction', $AlarmResetActionEnabled === 1);",
                    "width": "250px"
                },
                {
                    "type": "SelectAction",
                    "name": "AlarmResetAction",
                    "caption": "On alarm output reset",
                    "targetID": -2,
                    "width": "100%",
                    "enabled": false,
                    "visible": false
                },
                {
                    "type": "Select",
                    "name": "DisarmAfterAlarmActionEnabled",
                    "caption": "Disarm-after-alarm action",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Use action",
                            "value": 1
                        }
                    ],
                    "onChange": "OHA_SetOptionalActionFieldEnabled($id, 'DisarmAfterAlarmAction', $DisarmAfterAlarmActionEnabled === 1);",
                    "width": "250px"
                },
                {
                    "type": "SelectAction",
                    "name": "DisarmAfterAlarmAction",
                    "caption": "On disarm after alarm",
                    "targetID": -2,
                    "width": "100%",
                    "enabled": false,
                    "visible": false
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "System monitoring",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional 24/7 inputs for tamper, battery/power, communication or device faults."
                },
                {
                    "type": "Select",
                    "name": "FaultActionEnabled",
                    "caption": "New fault action",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Use action",
                            "value": 1
                        }
                    ],
                    "onChange": "OHA_SetOptionalActionFieldEnabled($id, 'FaultAction', $FaultActionEnabled === 1);",
                    "width": "250px"
                },
                {
                    "type": "SelectAction",
                    "name": "FaultAction",
                    "caption": "On new fault",
                    "targetID": -2,
                    "width": "100%",
                    "enabled": false,
                    "visible": false
                },
                {
                    "type": "Select",
                    "name": "FaultClearedActionEnabled",
                    "caption": "Fault cleared action",
                    "options": [
                        {
                            "caption": "No action",
                            "value": 0
                        },
                        {
                            "caption": "Use action",
                            "value": 1
                        }
                    ],
                    "onChange": "OHA_SetOptionalActionFieldEnabled($id, 'FaultClearedAction', $FaultClearedActionEnabled === 1);",
                    "width": "250px"
                },
                {
                    "type": "SelectAction",
                    "name": "FaultClearedAction",
                    "caption": "On fault cleared",
                    "targetID": -2,
                    "width": "100%",
                    "enabled": false,
                    "visible": false
                },
                {
                    "type": "List",
                    "name": "FaultInputs",
                    "caption": "Tamper and fault inputs",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Enabled",
                            "name": "Enabled",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable"
                            }
                        },
                        {
                            "caption": "Fault type",
                            "name": "FaultType",
                            "width": "180px",
                            "add": 0,
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Tamper",
                                        "value": 0
                                    },
                                    {
                                        "caption": "Battery / power",
                                        "value": 1
                                    },
                                    {
                                        "caption": "Communication",
                                        "value": 2
                                    },
                                    {
                                        "caption": "Device fault",
                                        "value": 3
                                    },
                                    {
                                        "caption": "Other fault",
                                        "value": 4
                                    }
                                ]
                            }
                        },
                        {
                            "caption": "Fault value",
                            "name": "TriggerValue",
                            "width": "125px",
                            "add": "1",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "",
                            "name": "TriggerValueSelection",
                            "width": "1px",
                            "visible": false,
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "",
                            "name": "TriggerValueManual",
                            "width": "1px",
                            "visible": false,
                            "add": "",
                            "save": false
                        },
                        {
                            "caption": "Block arming",
                            "name": "BlockArming",
                            "width": "120px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Alarm",
                            "name": "TriggerAlarm",
                            "width": "80px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        }
                    ],
                    "form": [
                        "return OHA_GetFaultInputEditForm($id, $FaultInputs);"
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Missing or unreadable configured fault variables are reported as a system fault and can block arming, but do not trigger the main alarm unless the configured fault value is positively detected."
                }
            ]
        },
        {
            "type": "List",
            "name": "Sensors",
            "caption": "Sensors and triggers",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Enabled",
                    "name": "Enabled",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Sensor type",
                    "name": "SensorType",
                    "width": "170px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Opening contact",
                                "value": 0
                            },
                            {
                                "caption": "Motion detector",
                                "value": 1
                            },
                            {
                                "caption": "Glass break detector",
                                "value": 2
                            },
                            {
                                "caption": "Smoke detector",
                                "value": 3
                            },
                            {
                                "caption": "Water detector",
                                "value": 4
                            },
                            {
                                "caption": "Panic trigger",
                                "value": 5
                            },
                            {
                                "caption": "Other trigger",
                                "value": 6
                            }
                        ]
                    }
                },
                {
                    "caption": "Trigger value",
                    "name": "TriggerValue",
                    "width": "125px",
                    "add": "1",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "",
                    "name": "TriggerValueSelection",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "",
                    "name": "TriggerValueManual",
                    "width": "1px",
                    "visible": false,
                    "add": "",
                    "save": false
                },
                {
                    "caption": "Home",
                    "name": "ArmHome",
                    "width": "90px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Away",
                    "name": "ArmAway",
                    "width": "95px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Night",
                    "name": "ArmNight",
                    "width": "75px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "24/7",
                    "name": "AlwaysActive",
                    "width": "70px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Exit route",
                    "name": "ExitDelay",
                    "width": "115px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Entry delay",
                    "name": "EntryDelay",
                    "width": "130px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ],
            "form": [
                "return OHA_GetSensorEditForm($id, $Sensors);"
            ]
        },
        {
            "type": "Label",
            "caption": "Selectable variable states are shown as a consistent list; variables without discrete states keep a raw-value input."
        },
        {
            "type": "Label",
            "caption": "24/7 sensors trigger immediately regardless of the current arming mode; mode assignments and entry/exit delay are ignored."
        }
    ],
    "actions": [],
    "status": []
}
